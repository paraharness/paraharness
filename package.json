{
  "name": "paraharness",
  "private": true,
  "version": "0.1.0",
  "description": "Declarative pure-AST agent orchestration DSL and durable execution runtime across isolated scopes.",
  "author": "Tornike Tsomaia",
  "license": "MIT",
  "homepage": "https://paraharness.github.io/paraharness/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paraharness/paraharness.git"
  },
  "bugs": {
    "url": "https://github.com/paraharness/paraharness/issues"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" run build",
    "docs:api": "node scripts/build-docs.mjs",
    "lint": "eslint \"packages/*/{src,test}/**/*.ts\" \"tests/*/{src,test}/**/*.ts\" \".agents/hooks/**/*.mjs\" \"scripts/**/*.mjs\" \"eslint.config.mjs\"",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=2 test"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "picomatch": "^4.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.9.0",
    "@types/picomatch": "^4.0.3",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-plugin-jsdoc": "^65.4.4",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "^5.8.2",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "node-pty",
      "protobufjs"
    ]
  }
}
