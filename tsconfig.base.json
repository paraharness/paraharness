{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@paraharness/lockfile": ["packages/lockfile/src/index.ts"],
      "@paraharness/core": ["packages/core/src/index.ts"],
      "@paraharness/core/runtime": ["packages/core/src/runtime/index.ts"],
      "@paraharness/sqlite": ["packages/sqlite/src/index.ts"],
      "@paraharness/postgres": ["packages/postgres/src/index.ts"],
      "@paraharness/fs": ["packages/fs/src/index.ts"],
      "@paraharness/markdown": ["packages/markdown/src/index.ts"],
      "@paraharness/node": ["packages/node/src/index.ts"],
      "@paraharness/git": ["packages/git/src/index.ts"],
      "@paraharness/claude": ["packages/claude/src/index.ts"],
      "@paraharness/openai": ["packages/openai/src/index.ts"],
      "@paraharness/gemini": ["packages/gemini/src/index.ts"],
      "@paraharness/github": ["packages/github/src/index.ts"],
      "@paraharness/slack": ["packages/slack/src/index.ts"],
      "@paraharness/stripe": ["tests/stripe/src/index.ts"],
      "@paraharness/netsuite": ["tests/netsuite/src/index.ts"]
    }
  }
}
