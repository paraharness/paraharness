{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Paraharness API Reference",
  "entryPointStrategy": "packages",
  "entryPoints": [
    "packages/*"
  ],
  "out": "docs-dist",
  "readme": "README.md",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeInternal": false,
  "packageOptions": {
    "validation": {
      "notExported": false
    }
  }
}
