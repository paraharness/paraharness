{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Paraharness API Reference",
  "plugin": [
    "typedoc-plugin-markdown",
    "typedoc-vitepress-theme"
  ],
  "out": "site/api",
  "docsRoot": "site",
  "readme": "none",
  "entryFileName": "index",
  "entryPointStrategy": "packages",
  "entryPoints": [
    "packages/*"
  ],
  "includeVersion": true,
  "excludePrivate": true,
  "excludeInternal": false,
  "excludeExternals": true,
  "outputFileStrategy": "members",
  "membersWithOwnFile": [
    "Class",
    "Function",
    "Variable",
    "Interface",
    "Enum"
  ],
  "groupOrder": [
    "Variables",
    "Functions",
    "Classes",
    "Interfaces",
    "Type Aliases",
    "*"
  ],
  "parametersFormat": "table",
  "interfacePropertiesFormat": "table",
  "enumMembersFormat": "table",
  "typeDeclarationFormat": "table",
  "indexFormat": "table",
  "useCodeBlocks": true,
  "expandObjects": false,
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "packageOptions": {
    "readme": "none",
    "excludeExternals": true,
    "groupOrder": [
      "Variables",
      "Functions",
      "Classes",
      "Interfaces",
      "Type Aliases",
      "*"
    ],
    "validation": {
      "notExported": false
    }
  }
}
