{
  "name": "@paraharness/node",
  "version": "0.2.0",
  "description": "Local OS subprocess runner pools, one-shot commands, circuit-breaking stream checks, framed PTY background daemons, and MCP control-plane adapters for Paraharness.",
  "keywords": [
    "paraharness",
    "nodejs",
    "subprocess",
    "pty",
    "daemon",
    "mcp",
    "model-context-protocol"
  ],
  "author": "Tornike Tsomaia",
  "license": "MIT",
  "homepage": "https://paraharness.github.io/paraharness/modules/_paraharness_node.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paraharness/paraharness.git",
    "directory": "packages/node"
  },
  "bugs": {
    "url": "https://github.com/paraharness/paraharness/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --dir . --passWithNoTests",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@paraharness/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fkill": "^10.0.3",
    "get-port": "^7.2.0",
    "node-pty": "^1.1.0",
    "p-limit": "^7.3.0",
    "p-queue": "^9.1.0",
    "pidtree": "^1.0.0",
    "wait-on": "^9.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/wait-on": "^5.3.4",
    "typescript": "^5.8.2",
    "vitest": "^3.2.0"
  },
  "typedocOptions": {
    "entryPoints": [
      "src/index.ts"
    ],
    "tsconfig": "tsconfig.build.json"
  }
}
