{
  "name": "@paraharness/markdown",
  "version": "0.1.0",
  "description": "Frontmatter and section-aware Markdown source loaders for Paraharness global rules, scoped rules, and on-demand skills.",
  "keywords": [
    "paraharness",
    "markdown",
    "frontmatter",
    "rules",
    "skills",
    "ai-agents"
  ],
  "author": "Tornike Tsomaia",
  "license": "MIT",
  "homepage": "https://paraharness.github.io/paraharness/modules/_paraharness_markdown.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paraharness/paraharness.git",
    "directory": "packages/markdown"
  },
  "bugs": {
    "url": "https://github.com/paraharness/paraharness/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --dir . --passWithNoTests",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@paraharness/core": "workspace:*",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-to-markdown": "^2.2.3",
    "micromark-extension-frontmatter": "^2.0.0",
    "picomatch": "^4.0.3",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/picomatch": "^4.0.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.0"
  },
  "typedocOptions": {
    "entryPoints": [
      "src/index.ts"
    ],
    "tsconfig": "tsconfig.build.json"
  }
}
