{
  "name": "@paraharness/memory",
  "version": "0.1.0",
  "description": "Unified Memory Harness for Paraharness providing atomic JSONL rules, lessons, and lifecycle-managed notes with 4-way path/glob scope matching, capacity buckets, Distiller proposals, and Git 3-way reconciliation.",
  "keywords": [
    "paraharness",
    "memory",
    "lessons",
    "rules",
    "notes",
    "ai-agents",
    "distiller"
  ],
  "author": "Tornike Tsomaia",
  "license": "MIT",
  "homepage": "https://paraharness.github.io/paraharness/modules/_paraharness_memory.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paraharness/paraharness.git",
    "directory": "packages/memory"
  },
  "bugs": {
    "url": "https://github.com/paraharness/paraharness/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --dir . --passWithNoTests",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@paraharness/lockfile": "workspace:*",
    "picomatch": "^4.0.3",
    "tinyglobby": "^0.2.17",
    "write-file-atomic": "^8.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/picomatch": "^4.0.3",
    "@types/write-file-atomic": "^4.0.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.0"
  },
  "typedocOptions": {
    "entryPoints": [
      "src/index.ts"
    ],
    "tsconfig": "tsconfig.build.json"
  }
}
