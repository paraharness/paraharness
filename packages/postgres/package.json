{
  "name": "@paraharness/postgres",
  "version": "0.2.1",
  "description": "Distributed PostgreSQL runtime drivers for Paraharness LedgerStore, Copy-on-Write TopologyStore, LessonStore, and global rules sources.",
  "keywords": [
    "paraharness",
    "postgres",
    "postgresql",
    "ledger",
    "topology",
    "lessons",
    "ai-agents"
  ],
  "author": "Tornike Tsomaia",
  "license": "MIT",
  "homepage": "https://paraharness.github.io/paraharness/modules/_paraharness_postgres.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paraharness/paraharness.git",
    "directory": "packages/postgres"
  },
  "bugs": {
    "url": "https://github.com/paraharness/paraharness/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --dir . --passWithNoTests",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@dagrejs/graphlib": "^4.0.7",
    "@paraharness/core": "workspace:*",
    "minisearch": "^7.2.0",
    "node-diff3": "^3.2.1",
    "p-queue": "^9.1.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "^12.8.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.0",
    "@electric-sql/pglite": "^0.5.15"
  },
  "typedocOptions": {
    "entryPoints": [
      "src/index.ts"
    ],
    "tsconfig": "tsconfig.build.json"
  }
}
