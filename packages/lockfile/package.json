{
  "name": "@paraharness/lockfile",
  "version": "0.2.0",
  "description": "Cross-process advisory lockfile utility with p-queue in-process serialization, atomic wx file creation, utimes heartbeat, and stale lock reclamation.",
  "keywords": [
    "paraharness",
    "lockfile",
    "mutex",
    "concurrency",
    "advisory-lock",
    "ipc"
  ],
  "author": "Tornike Tsomaia",
  "license": "MIT",
  "homepage": "https://paraharness.github.io/paraharness/modules/_paraharness_lockfile.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paraharness/paraharness.git",
    "directory": "packages/lockfile"
  },
  "bugs": {
    "url": "https://github.com/paraharness/paraharness/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --dir . --passWithNoTests",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "p-queue": "^9.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.0"
  },
  "typedocOptions": {
    "entryPoints": [
      "src/index.ts"
    ],
    "tsconfig": "tsconfig.build.json"
  }
}
