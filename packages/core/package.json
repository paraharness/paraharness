{
  "name": "@paraharness/core",
  "version": "0.1.0",
  "description": "Declarative pure-AST agent orchestration DSL (P.*), capability-tiered isolation scope ports, and durable continuation-stack execution runtime.",
  "keywords": [
    "paraharness",
    "ai-agents",
    "llm",
    "orchestration",
    "dsl",
    "ast",
    "workflow",
    "durable-execution"
  ],
  "author": "Tornike Tsomaia",
  "license": "MIT",
  "homepage": "https://paraharness.github.io/paraharness/modules/_paraharness_core.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paraharness/paraharness.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/paraharness/paraharness/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --dir . --passWithNoTests",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@dagrejs/graphlib": "^4.0.7",
    "diff": "^9.0.0",
    "p-limit": "^7.3.0",
    "p-queue": "^9.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.0"
  },
  "typedocOptions": {
    "entryPoints": [
      "src/index.ts",
      "src/runtime/index.ts"
    ],
    "tsconfig": "tsconfig.build.json"
  }
}
