{
  "name": "@paraharness/claude",
  "version": "0.2.0",
  "description": "Anthropic Claude ModelDriver and AST builders for Paraharness supporting API key and CLI OAuth subscription seats, KV prefix caching, and thinking signature preservation.",
  "keywords": [
    "paraharness",
    "anthropic",
    "claude",
    "llm",
    "model-driver",
    "ai-agents"
  ],
  "author": "Tornike Tsomaia",
  "license": "MIT",
  "homepage": "https://paraharness.github.io/paraharness/modules/_paraharness_claude.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paraharness/paraharness.git",
    "directory": "packages/claude"
  },
  "bugs": {
    "url": "https://github.com/paraharness/paraharness/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --dir . --passWithNoTests",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@paraharness/core": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.0"
  },
  "typedocOptions": {
    "entryPoints": [
      "src/index.ts"
    ],
    "tsconfig": "tsconfig.build.json"
  }
}
